{
  "name": "shopsmart-backend",
  "version": "1.0.0",
  "description": "Backend API for ShopSmart",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --forceExit",
    "test:api": "jest --testPathPattern=tests/ --forceExit",
    "test:ci": "jest --testPathPattern=tests/ --forceExit --coverage --coverageDirectory=coverage --coverageReporters=lcov,text,json-summary",
    "lint": "eslint src/**/*.js --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    },
    "reporters": [
      "default",
      ["jest-junit", {
        "outputDirectory": "./test-reports",
        "outputName": "backend-junit.xml",
        "classNameTemplate": "{classname}",
        "titleTemplate": "{title}"
      }]
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  }
}
